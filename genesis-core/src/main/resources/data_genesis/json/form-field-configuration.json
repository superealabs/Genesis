        "fields": [
          {
            "name": "min",
            "type": "number"
          },
          {
            "name": "max",
            "type": "number"
          },
          {
            "name": "step",
            "type": "number"
          }
        ]
      }
    },

    "range": {
      "configuration": {
        "fields": [
          {
            "name": "min",
            "type": "number"
          },
          {
            "name": "max",
            "type": "number"
          },
          {
            "name": "step",
            "type": "number"
          }
        ]
      }
    },

    "quantity": {
      "configuration": {
        "fields": [
          {
            "name": "min",
            "type": "number"
          },
          {
            "name": "max",
            "type": "number"
          },
          {
            "name": "step",
            "type": "number"
          }
