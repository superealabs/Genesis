              "USD",
              "GBP",
              "MGA"
            ]
          },
          {
            "name": "min",
            "type": "number"
          },
          {
            "name": "max",
            "type": "number"
          },
          {
            "name": "step",
            "type": "number"
          }
        ]
      }
    },

    "file": {
      "configuration": {
        "fields": [
          {
            "name": "accept",
            "type": "multi-select",
            "options": [
              ".jpg",
              ".jpeg",
              ".png",
              ".gif",
              ".pdf",
              ".csv",
              ".txt",
              ".doc",
              ".docx",
              ".xls",
              ".xlsx",
              ".zip"
            ]
          }
        ]
      }
