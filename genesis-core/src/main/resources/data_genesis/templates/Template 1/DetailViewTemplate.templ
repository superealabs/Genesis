${modelType}
<!-- Header -->
<header class="header">
    <h3>${className} / <span class="page-action">Details</span></h3>
</header>

<!-- Content -->
<main class="content">
    <!-- Table -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    {{#each fields}}
                    <th>${this.name}</th>
                    {{/each}}{{removeLine}}
                </tr>
            </thead>
            <tbody>
                <tr>
                {{#each fields}}
                    <td>${dataValue}</td>
                {{/each}}{{removeLine}}
                </tr>
            </tbody>
        </table>
    </div>
</main>

