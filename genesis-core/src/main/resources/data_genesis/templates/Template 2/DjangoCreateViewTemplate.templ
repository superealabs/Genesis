{% extends "TestDjangoProjectMVT/base.html" %}

{% block content %}

${viewAnnotations}
<div class="header">
    <h1 class="page-title">${className} / <span class="page-type"><span class="page-action"
                data-i18n="create">Create</span></span></h1>
    <a href="${backLink}" class="btn btn-primary btn-md">


        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        <p data-i18n="back_list"></p>
    </a>
</div>

${validationSection}

{% if form.non_field_errors %}
<div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 15px; margin: 20px 0; border-radius: 5px;">
    <h3>Erreurs générales:</h3>
    {{ form.non_field_errors }}
</div>
{% endif %}

<!-- Include Select2 utils scripts -->
{% load static %}
<script src="{% ${rootPath} 'js/jquery-3.7.1.min.js' %}"></script>
<link rel="stylesheet" href="{% ${rootPath} 'css/select2.min.css' %}">
<script src="{% ${rootPath} 'js/select2.min.js' %}"></script>

<form class="form" method="post" ${createLink}>
    {% csrf_token %}
    {{#each inputs}}
    <div class="form-group">
        <label for="${this.name}">${this.name}
            {{#if this.isRequired}}<span class="required-sign">*</span>{{else}}{{removeLine}}{{/if}}
        </label>
        {{#if this.type = radio}}{{removeLine}}
        <div class="boolean-radio-group">
            <label class="radio-option">
                <input type="radio" ${inputTagHelper} ${checkedRadioTagHelper} value="true">
                <span class="radio-label">True</span>
            </label>
            <label class="radio-option">
                <input type="radio" ${inputTagHelper} ${checkedRadioTagHelper} value="false">
                <span class="radio-label">False</span>
            </label>
        </div>
        {{else}}{{removeLine}}
        {{ form.${this.name} }}
        {{/if}}{{removeLine}}
        <span class="field-validation-error">{{ form.${this.name}.errors }}</span>
    </div>
    {{/each}}{{removeLine}}

    {{#each fieldsFK}}
    <div class="form-group">
        <label for="${this.columnNameField}">${this.columnNameField}
            {{#if this.isRequired}}<span class="required-sign">*</span>{{else}}{{removeLine}}{{/if}}
        </label>
        {{ form.${this.name} }}
        <span class="field-validation-error">{{ form.${this.name}.errors }}</span>

        <script>
            $(document).ready(function() {
                $('#${this.columnNameField}').select2({
                    placeholder: "",
                    allowClear: true,
                    width: '100%',
                    ajax: {
                        url: "{% url '${this.typeLowerCase}_search' %}",
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            return { q: params.term || '' };
                        },
                        processResults: function (data) {
                            return { results: data };
                        }
                    },
                    minimumInputLength: 0
                });
            });
        </script>
    </div>
    {{/each}}{{removeLine}}

    {{#each textAreas}}
    <div class="form-group full-width">
        <label for="${this.name}" >${this.name}
            {{#if this.isRequired}}<span class="required-sign">*</span>{{else}}{{removeLine}}{{/if}}
        </label>
        <textarea ${textAreaTagHelper} rows="4"
            placeholder=${this.placeholder} class="${this.class}">
        </textarea>
    </div>
    <span ${textAreaValidationTagHelper} class="field-validation-error"></span>
    {{/each}}{{removeLine}}

    <div class="form-actions">
        <div class="form-actions-left">
            <button type="reset" class="btn btn-tertiary btn-md">
                <span data-i18n="reset"></span>
            </button>
        </div>

        <div class="form-actions-right">
            <a href="${previousLink}" type="button" class="btn btn-secondary btn-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
                <span data-i18n="cancel"></span>
            </a>

            <button type="submit" class="btn btn-secondary btn-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                    <path d="M17 21v-8H7v8M7 3v5h8" />
                </svg>
                <span data-i18n="save"></span>
            </button>
        </div>
    </div>
</form>
${scriptSection}
{% endblock %}