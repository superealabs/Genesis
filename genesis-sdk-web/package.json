{
  "name": "genesis-sdk-web",
  "private": true,
  "scripts": {
    "build": "npm run build:types && npm run build:core && npm run build:all",
    "build:types": "cd genesis-web-types-shared && npm run build",
    "build:core": "cd genesis-web-core && npm run build",
    "build:all": "npm run build:vsc && npm run build:web",
    "build:vsc": "cd genesis-vsc && npm run build",
    "build:web": "cd genesis-web && npm run build",
    "dev": "concurrently \"npm run dev:vsc\" \"npm run dev:web\"",
    "dev:vsc": "cd genesis-vsc && npm run watch",
    "dev:web": "cd genesis-web && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}