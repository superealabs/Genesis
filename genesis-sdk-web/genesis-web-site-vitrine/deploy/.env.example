# Copier en .env (cp .env.example .env) puis remplir. Ne jamais versionner .env.

# Port local de la passerelle. Le Nginx du VPS envoie le domaine vers 127.0.0.1:HTTP_PORT
# Choisir un port libre sur le VPS (les autres sites de ton chef en utilisent peut-être déjà).
HTTP_PORT=8080

# Base PostgreSQL du site (créée au premier lancement)
POSTGRES_DB=site_genesis
POSTGRES_USER=genesis
POSTGRES_PASSWORD=change-moi-mot-de-passe-long

# Clé de l'Assistant IA (Groq). Vide = l'Assistant IA répond « aucune clé API ».
GENESIS_LLM_API_KEY=
