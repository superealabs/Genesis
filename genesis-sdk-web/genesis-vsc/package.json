{
  "name": "genesis",
  "displayName": "genesis",
  "description": "Genesis Extension",
  "version": "0.0.1",
  "icon": "resources/genesis-icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/superealabs/Genesis"
  },
  "workspaces": [
    "packages/webview"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genesis-sidebar",
          "title": "Genesis",
          "icon": "resources/genesis-icon.png" 
        }
      ]
    },
    "commands": [
      {
        "command": "genesis.helloWorld",
        "title": "Genesis : Home page"
      },
      {
        "command": "genesis.resetRecent",
        "title": "Genesis: Réinitialiser les récents",
        "icon": "$(trash)"
      },
      {
        "command": "genesis.resetConfig",
        "title": "Genesis: Réinitialiser les configurations",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Genesis",
      "properties": {
        "genesis.theme": {
          "type": "string",
          "default": "genesis",
          "enum": [
            "genesis",
            "vscode",
            "mono"
          ],
          "enumDescriptions": [
            "Thème Genesis (défaut)",
            "Suit le thème VS Code",
            "Monochrome noir et blanc"
          ],
          "description": "Thème de l'interface Genesis"
        },
        "genesis.colorMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Suit automatiquement VS Code",
            "Forcer le mode clair",
            "Forcer le mode sombre"
          ],
          "description": "Mode de couleur de l'interface Genesis"
        },
        "genesis.recentResetScope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "frameworks",
            "databases",
            "frontends"
          ],
          "enumDescriptions": [
            "Réinitialise toutes les catégories de récents",
            "Réinitialise uniquement les frameworks récents",
            "Réinitialise uniquement les bases de données récentes",
            "Réinitialise uniquement les frontends récents"
          ],
          "description": "Portée de la réinitialisation des éléments récents"
        },
        "genesis.configResetScope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "framework_technical-stack",
            "framework_advanced-configuration",
            "generator_generation-options",
            "frontend_languages-configuration"
          ],
          "enumDescriptions": [
            "Réinitialise toutes les configurations",
            "Réinitialise uniquement les stacks techniques de frameworks",
            "Réinitialise uniquement les configurations avancées de frameworks",
            "Réinitialise uniquement les options de génération",
            "Réinitialise uniquement les configurations de langues frontend"
          ],
          "description": "Portée de la réinitialisation des configurations Genesis"
        }

      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "genesis.resetRecent",
          "when": "activeWebviewPanelId == 'genesisWebview'",
          "group": "navigation"
        },
        {
          "command": "genesis.resetConfig",
          "when": "activeWebviewPanelId == 'genesisWebview'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "genesis.resetRecent"
        },
        { 
          "command": "genesis.resetConfig", 
          "when": "true" 
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run build:webview && webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build:webview": "cd packages/webview && npm run build",
    "watch:webview": "cd packages/webview && npm run dev -- --watch",
    "dev": "concurrently \"npm run watch:webview\" \"npm run watch\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "@genesis-labs/shared-types": "*"
  }
}
