{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0", /* condition pour faire marché la base url */
    "paths": {
      "@/*": ["./src/*"],
      "@genesis-labs/web-core/*": ["../../../genesis-web-core/src/*"],
      "@genesis-labs/shared-types": ["../../../genesis-web-types-shared/src/index.ts"]
    },
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client", "node"]
  },
  "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.vue",
      "src/vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../../genesis-web-core/tsconfig.app.json" },
    { "path": "../../../genesis-web-types-shared/tsconfig.json" }
  ]
}