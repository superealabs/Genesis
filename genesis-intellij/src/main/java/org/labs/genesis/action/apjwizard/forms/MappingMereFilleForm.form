<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.labs.genesis.action.apjwizard.forms.MappingMereFilleForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="550"/>
    </constraints>
    <properties>
      <maximumSize width="500" height="550"/>
      <minimumSize width="500" height="550"/>
      <preferredSize width="500" height="550"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="f6206" binding="generalPanel" layout-manager="GridLayoutManager" row-count="5" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ce4d8" class="javax.swing.JLabel" binding="nomLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nom Mère :"/>
            </properties>
          </component>
          <component id="4a60b" class="javax.swing.JTextField" binding="nomField">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="e2a02" class="javax.swing.JLabel" binding="superClasse">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nom Table Mère :"/>
            </properties>
          </component>
          <grid id="27836" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="292bd" class="javax.swing.JButton" binding="chooseTableButton">
                <constraints border-constraint="East"/>
                <properties>
                  <icon value="icons/table.png"/>
                  <maximumSize width="30" height="30"/>
                  <minimumSize width="30" height="30"/>
                  <preferredSize width="30" height="30"/>
                  <text value=""/>
                </properties>
              </component>
              <component id="905ce" class="javax.swing.JTextField" binding="nomTableField">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
            </children>
          </grid>
          <component id="a8872" class="javax.swing.JTextField" binding="liaison">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="309e9" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Liaison :"/>
            </properties>
          </component>
          <grid id="801ba" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="70258" class="javax.swing.JButton" binding="chooseTableFilleButton">
                <constraints border-constraint="East"/>
                <properties>
                  <icon value="icons/table.png"/>
                  <maximumSize width="30" height="30"/>
                  <minimumSize width="30" height="30"/>
                  <preferredSize width="30" height="30"/>
                  <text value=""/>
                </properties>
              </component>
              <component id="564b6" class="javax.swing.JTextField" binding="nomTableFilleField">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
            </children>
          </grid>
          <component id="4af3a" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nom Table Fille:"/>
            </properties>
          </component>
          <component id="c674d" class="javax.swing.JTextField" binding="nomFilleField">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="883fc" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nom Fille :"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="6e8ef" binding="propertiesPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="f6d45" binding="scrollProperties">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <tabbedpane id="b0024" binding="tabPane">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="e30cb" binding="filtrePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints>
                      <tabbedpane title="Attributs à générer Mère"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="b0dfc" binding="scrollFiltre">
                        <constraints border-constraint="Center"/>
                        <properties/>
                        <border type="none"/>
                        <children/>
                      </scrollpane>
                    </children>
                  </grid>
                  <grid id="83c6a" binding="fillePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints>
                      <tabbedpane title="Attributs à générer Fille"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="40d39" binding="scrollFille">
                        <constraints border-constraint="Center"/>
                        <properties/>
                        <border type="none"/>
                        <children/>
                      </scrollpane>
                    </children>
                  </grid>
                </children>
              </tabbedpane>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
