<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.labs.genesis.action.apjwizard.forms.PageRechercheForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="400" height="450"/>
    </constraints>
    <properties>
      <maximumSize width="400" height="450"/>
      <minimumSize width="400" height="450"/>
      <preferredSize width="400" height="450"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="f6206" binding="generalPanel" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ce4d8" class="javax.swing.JLabel" binding="nomLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nom:"/>
            </properties>
          </component>
          <component id="ca00c" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Mapping:"/>
            </properties>
          </component>
          <component id="8966a" class="javax.swing.JLabel" binding="nomTableLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="NomTable:"/>
            </properties>
          </component>
          <component id="76c75" class="javax.swing.JLabel" binding="titreLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Titre:"/>
            </properties>
          </component>
          <component id="4a60b" class="javax.swing.JTextField" binding="nomField">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="f5c45" class="javax.swing.JTextField" binding="titreField">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <grid id="1573e" binding="mappingPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="ed369" class="javax.swing.JTextField" binding="mappingField">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
              <component id="7806e" class="javax.swing.JButton" binding="chooseClassButton">
                <constraints border-constraint="East"/>
                <properties>
                  <maximumSize width="30" height="30"/>
                  <minimumSize width="30" height="30"/>
                  <preferredSize width="30" height="30"/>
                  <text value="..."/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="d5c14" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="e8caf" class="javax.swing.JButton" binding="chooseTableButton">
                <constraints border-constraint="East"/>
                <properties>
                  <maximumSize width="30" height="30"/>
                  <minimumSize width="30" height="30"/>
                  <preferredSize width="30" height="30"/>
                  <text value="..."/>
                </properties>
              </component>
              <component id="482bb" class="javax.swing.JTextField" binding="nomTableField">
                <constraints border-constraint="Center"/>
                <properties/>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="6e8ef" binding="propertiesPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="f6d45" binding="scrollProperties">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <tabbedpane id="b0024" binding="tabPane">
                <constraints/>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="e30cb" binding="filtrePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                    <constraints>
                      <tabbedpane title="Filtre"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="b0dfc" binding="scrollFiltre">
                        <constraints border-constraint="Center"/>
                        <properties/>
                        <border type="none"/>
                        <children/>
                      </scrollpane>
                    </children>
                  </grid>
                  <grid id="e77d" binding="recapitulationPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="0">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <tabbedpane title="Récapitulation"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="9f3f4" binding="scrollRecap">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties/>
                        <border type="none"/>
                        <children/>
                      </scrollpane>
                    </children>
                  </grid>
                  <grid id="ae787" binding="tableauPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <tabbedpane title="Tableau"/>
                    </constraints>
                    <properties/>
                    <border type="none"/>
                    <children>
                      <scrollpane id="6d4d8" binding="scrollTableau">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties/>
                        <border type="none"/>
                        <children/>
                      </scrollpane>
                    </children>
                  </grid>
                </children>
              </tabbedpane>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
