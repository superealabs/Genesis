<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.labs.genesis.forms.DataSourceChoiceForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
    <margin top="30" left="30" bottom="30" right="30"/>
    <constraints>
      <xy x="20" y="20" width="700" height="450"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="titleLabel" class="javax.swing.JLabel" binding="titleLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="16" style="1"/>
          <text value="Source des données du projet"/>
        </properties>
      </component>
      <component id="subtitleLabel" class="javax.swing.JLabel" binding="subtitleLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Choisissez comment définir la structure des données pour votre projet :"/>
        </properties>
      </component>
      <component id="databaseCheckBox" class="javax.swing.JCheckBox" binding="databaseCheckBox">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font style="1"/>
          <text value="Avec la base de données"/>
        </properties>
      </component>
      <component id="databaseDescLabel" class="javax.swing.JLabel" binding="databaseDescLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Se connecter directement à une base de données existante (PostgreSQL, MySQL, Oracle, etc.)."/>
        </properties>
      </component>
      <component id="scriptCheckBox" class="javax.swing.JCheckBox" binding="scriptCheckBox">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font style="1"/>
          <text value="Avec un script"/>
        </properties>
      </component>
      <component id="scriptDescLabel" class="javax.swing.JLabel" binding="scriptDescLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Charger ou générer un script SQL pour créer le schéma de la base de données."/>
        </properties>
      </component>
      <vspacer id="vspacer">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
