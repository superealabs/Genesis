<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.labs.genesis.forms.ScriptDatabaseConfigurationForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="9" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="850" height="550"/>
    </constraints>
    <properties>
      <minimumSize width="550" height="450"/>
    </properties>
    <border type="none"/>
    <children>
      <!-- Row 0: Database Type -->
      <component id="dbLabel" class="javax.swing.JLabel" binding="databaseLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Database Type:"/>
        </properties>
      </component>
      <component id="dmsOptions" class="javax.swing.JComboBox" binding="dmsOptions">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>

      <!-- Row 1: SQL Script Location -->
      <component id="locLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="SQL script location:"/>
        </properties>
      </component>
      <component id="locField" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="locationField">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>

      <!-- Row 2: SQL Editor -->
      <component id="sqlLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="SQL Script:"/>
        </properties>
      </component>
      <grid id="editorGrid" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="450" height="150"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="rScroll" class="org.fife.ui.rtextarea.RTextScrollPane" binding="rTextScrollPane">
            <constraints border-constraint="Center"/>
            <properties>
              <foldIndicatorEnabled value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="sqlArea" class="org.fife.ui.rsyntaxtextarea.RSyntaxTextArea" binding="sqlTextArea">
                <constraints/>
                <properties>
                  <alignmentX value="0.5"/>
                  <alignmentY value="0.5"/>
                  <codeFoldingEnabled value="true"/>
                  <lineWrap value="true"/>
                  <margin top="0" left="0" bottom="0" right="0"/>
                  <showMatchedBracketPopup value="false"/>
                  <syntaxEditingStyle value="text/sql"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>

      <!-- Row 3: Use LLM & Schema checkboxes -->
      <component id="llmCheck" class="javax.swing.JCheckBox" binding="useLLMCheckBox" default-binding="true">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Use LLM"/>
        </properties>
      </component>
      <component id="schemaCheck" class="javax.swing.JCheckBox" binding="addDBSchemaCheckBox" default-binding="true">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Add DB schema to prompt"/>
        </properties>
      </component>

      <!-- Row 4: Model LLM -->
      <component id="modelLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="68" height="15"/>
          </grid>
        </constraints>
        <properties>
          <text value="Model LLM:"/>
        </properties>
      </component>
      <component id="modelCombo" class="javax.swing.JComboBox" binding="llmModelComboBox" default-binding="true">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>

      <!-- Row 5: Use personal access token -->
      <component id="tokenCheck" class="javax.swing.JCheckBox" binding="usePersonalAccessTokenCheckBox" default-binding="true">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <selected value="false"/>
          <text value="Use personal access token"/>
        </properties>
      </component>

      <!-- Row 6: Token -->
      <component id="tokenLabel" class="javax.swing.JLabel" binding="tokenLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="68" height="15"/>
          </grid>
        </constraints>
        <properties>
          <text value="Token:"/>
        </properties>
      </component>
      <component id="tokenField" class="javax.swing.JPasswordField" binding="tokenApiField">
        <constraints>
          <grid row="6" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>

      <!-- Row 7: Prompt & Generate -->
      <component id="promptLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Prompt:"/>
        </properties>
      </component>
      <scrollpane id="promptScroll">
        <constraints>
          <grid row="7" column="2" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="450" height="90"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="promptText" class="javax.swing.JTextArea" binding="promptTextArea" default-binding="true">
            <constraints/>
            <properties>
              <columns value="20"/>
              <lineWrap value="true"/>
              <rows value="4"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="genLink" class="com.intellij.ui.components.labels.LinkLabel" binding="generateScriptLinkLabel">
        <constraints>
          <grid row="7" column="3" row-span="1" col-span="1" vsize-policy="3" hsize-policy="2" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="80" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="Generate"/>
          <toolTipText value="Generate SQL from prompt"/>
        </properties>
      </component>

      <!-- Row 8: vspacer -->
      <vspacer id="spacerBottom">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
