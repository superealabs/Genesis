<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.labs.genesis.forms.SQLRunnerForm">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="10" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="30" left="30" bottom="30" right="30"/>
    <constraints>
      <xy x="20" y="20" width="844" height="519"/>
    </constraints>
    <properties>
      <minimumSize width="548" height="440"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="a18f6" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="SQL script location"/>
        </properties>
      </component>
      <component id="9ab7e" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="locationField">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <vspacer id="71d65">
        <constraints>
          <grid row="9" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="c06d4" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="68" height="15"/>
          </grid>
        </constraints>
        <properties>
          <labelFor value="dd72"/>
          <text value="Model LLM:"/>
        </properties>
      </component>
      <component id="a5713" class="javax.swing.JPasswordField" binding="tokenApiField">
        <constraints>
          <grid row="6" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="a934e" class="javax.swing.JLabel" binding="nameLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="68" height="15"/>
          </grid>
        </constraints>
        <properties>
          <labelFor value="a9735"/>
          <text value="Token:"/>
        </properties>
      </component>
      <component id="9f20c" class="javax.swing.JLabel">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Prompt"/>
        </properties>
      </component>
      <scrollpane id="b1209">
        <constraints>
          <grid row="7" column="2" row-span="2" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a6238" class="javax.swing.JTextArea" binding="promptTextArea" default-binding="true">
            <constraints/>
            <properties>
              <columns value="20"/>
              <lineWrap value="true"/>
              <preferredSize width="462" height="1020"/>
              <rows value="60"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="5b655" class="javax.swing.JCheckBox" binding="usePersonalAccessTokenCheckBox" default-binding="true">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <selected value="true"/>
          <text value="Use personal access token"/>
        </properties>
      </component>
      <component id="4863d" class="javax.swing.JCheckBox" binding="useLLMCheckBox" default-binding="true">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Use LLM"/>
        </properties>
      </component>
      <component id="c4f33" class="javax.swing.JComboBox" binding="llmModelComboBox" default-binding="true">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="298" height="34"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="b4dd6" class="com.intellij.ui.components.labels.LinkLabel" binding="generateScriptLinkLabel">
        <constraints>
          <grid row="7" column="3" row-span="1" col-span="1" vsize-policy="3" hsize-policy="2" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="100" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <text value="Generate"/>
          <toolTipText value="Generate"/>
        </properties>
      </component>
      <component id="5e0a5" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
