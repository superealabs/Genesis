        </properties>
      </component>
      <component id="89771" class="com.intellij.ui.components.labels.LinkLabel" binding="executeLinkLabel">
        <constraints>
          <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Execute"/>
        </properties>
      </component>
      <grid id="182f2" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="816ae" class="org.fife.ui.rtextarea.RTextScrollPane" binding="rTextScrollPane">
            <constraints border-constraint="Center"/>
            <properties>
              <foldIndicatorEnabled value="false"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="f465a" class="org.fife.ui.rsyntaxtextarea.RSyntaxTextArea" binding="sqlTextArea">
                <constraints/>
                <properties>
                  <alignmentX value="0.5"/>
                  <alignmentY value="0.5"/>
                  <codeFoldingEnabled value="true"/>
                  <lineWrap value="true"/>
                  <margin top="0" left="0" bottom="0" right="0"/>
                  <showMatchedBracketPopup value="false"/>
                  <syntaxEditingStyle value="text/sql"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <component id="f5385" class="javax.swing.JCheckBox" binding="addDBSchemaCheckBox" default-binding="true">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Add DB schema to prompt"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
