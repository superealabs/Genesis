<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.labs.genesis.forms.RuleToCodeForm">
  <grid id="rootGrid" binding="mainPanel" layout-manager="GridLayoutManager" row-count="9" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="0" y="0" width="600" height="450"/>
    </constraints>
    <properties/>
    <border type="empty"/>
    <children>
      <component id="126d" class="javax.swing.JComboBox" binding="selectFramework">
        <constraints>
          <grid row="2" column="1" row-span="4" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model/>
        </properties>
      </component>
      <component id="17666" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Select framework:"/>
        </properties>
      </component>
      <component id="generateYamlButton" class="javax.swing.JButton" binding="generateYamlButton">
        <constraints>
          <grid row="6" column="1" row-span="2" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Generate YAML"/>
        </properties>
      </component>
      <scrollpane id="427ba">
        <constraints>
          <grid row="8" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="95584" class="javax.swing.JTextArea" binding="yamlContentArea">
            <constraints/>
            <properties>
              <background color="-1"/>
              <font name="Alef" style="0"/>
              <foreground color="-16777216"/>
              <text value=""/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="folderLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="3" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Select project folder:"/>
        </properties>
      </component>
      <component id="folderField" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="folderField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="yamlLabel" class="javax.swing.JLabel">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="YAML Content:"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
