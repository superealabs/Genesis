<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/"
      version="1"
      bind-to-class="org.labs.genesis.forms.DockerConfigurationForm">

  <grid id="27dc6"
        binding="mainPanel"
        layout-manager="GridLayoutManager"
        row-count="10"
        column-count="4"
        same-size-horizontally="false"
        same-size-vertically="false"
        hgap="10"
        vgap="8">

    <margin top="20" left="20" bottom="20" right="20"/>

    <constraints>
      <xy x="20" y="20" width="650" height="500"/>
    </constraints>

    <properties/>
    <border type="none"/>

    <children>

      <!-- ===================================================== -->
      <!-- TITLE -->
      <!-- ===================================================== -->

      <component id="dockerTitle"
                 class="javax.swing.JLabel">

        <constraints>
          <grid row="0"
                column="0"
                row-span="1"
                col-span="4"
                vsize-policy="0"
                hsize-policy="0"
                anchor="8"
                fill="0"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Docker configuration"/>
          <font size="16" style="1"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- DOCKER CONFIGURATION -->
      <!-- ===================================================== -->

      <component id="configureDocker"
                 class="javax.swing.JCheckBox"
                 binding="configureDockerCheckBox"
                 default-binding="true">

        <constraints>
          <grid row="1"
                column="0"
                row-span="1"
                col-span="4"
                vsize-policy="0"
                hsize-policy="3"
                anchor="8"
                fill="0"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Configure Docker"/>
          <selected value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- DOCKER GENERATION MODE -->
      <!-- ===================================================== -->

      <component id="dockerGenerationModeLabel"
                 class="javax.swing.JLabel"
                 binding="dockerGenerationModeLabel">

        <constraints>
          <grid row="2"
                column="0"
                row-span="1"
                col-span="4"
                vsize-policy="0"
                hsize-policy="0"
                anchor="8"
                fill="0"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Docker generation:"/>
          <visible value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- DOCKER FRONTEND -->
      <!-- ===================================================== -->

      <component id="dockerFrontend"
                 class="javax.swing.JRadioButton"
                 binding="dockerFrontendRadioButton"
                 default-binding="true">

        <constraints>
          <grid row="3"
                column="0"
                row-span="1"
                col-span="4"
                vsize-policy="0"
                hsize-policy="3"
                anchor="8"
                fill="0"
                indent="1"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Frontend only"/>
          <selected value="false"/>
          <visible value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- DOCKER BACKEND -->
      <!-- ===================================================== -->

      <component id="dockerBackend"
                 class="javax.swing.JRadioButton"
                 binding="dockerBackendRadioButton"
                 default-binding="true">

        <constraints>
          <grid row="4"
                column="0"
                row-span="1"
                col-span="4"
                vsize-policy="0"
                hsize-policy="3"
                anchor="8"
                fill="0"
                indent="1"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Backend only"/>
          <selected value="false"/>
          <visible value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- DOCKER BOTH -->
      <!-- ===================================================== -->

      <component id="dockerBoth"
                 class="javax.swing.JRadioButton"
                 binding="dockerBothRadioButton"
                 default-binding="true">

        <constraints>
          <grid row="5"
                column="0"
                row-span="1"
                col-span="4"
                vsize-policy="0"
                hsize-policy="3"
                anchor="8"
                fill="0"
                indent="1"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Frontend + Backend"/>
          <selected value="true"/>
          <visible value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- FRONTEND CONTAINER -->
      <!-- ===================================================== -->

      <component id="frontendContainerNameLabel"
                 class="javax.swing.JLabel"
                 binding="frontendContainerNameLabel">

        <constraints>
          <grid row="6"
                column="0"
                row-span="1"
                col-span="1"
                vsize-policy="0"
                hsize-policy="0"
                anchor="8"
                fill="0"
                indent="2"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Frontend container:"/>
          <visible value="false"/>
        </properties>

      </component>


      <component id="frontendContainerName"
                 class="javax.swing.JTextField"
                 binding="frontendContainerNameField"
                 default-binding="true">

        <constraints>
          <grid row="6"
                column="1"
                row-span="1"
                col-span="3"
                vsize-policy="0"
                hsize-policy="6"
                anchor="8"
                fill="1"
                indent="0"
                use-parent-layout="false">

            <preferred-size width="250" height="-1"/>

          </grid>
        </constraints>

        <properties>
          <text value="frontend"/>
          <visible value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- BACKEND CONTAINER -->
      <!-- ===================================================== -->

      <component id="backendContainerNameLabel"
                 class="javax.swing.JLabel"
                 binding="backendContainerNameLabel">

        <constraints>
          <grid row="7"
                column="0"
                row-span="1"
                col-span="1"
                vsize-policy="0"
                hsize-policy="0"
                anchor="8"
                fill="0"
                indent="2"
                use-parent-layout="false"/>
        </constraints>

        <properties>
          <text value="Backend container:"/>
          <visible value="false"/>
        </properties>

      </component>


      <component id="backendContainerName"
                 class="javax.swing.JTextField"
                 binding="backendContainerNameField"
                 default-binding="true">

        <constraints>
          <grid row="7"
                column="1"
                row-span="1"
                col-span="3"
                vsize-policy="0"
                hsize-policy="6"
                anchor="8"
                fill="1"
                indent="0"
                use-parent-layout="false">

            <preferred-size width="250" height="-1"/>

          </grid>
        </constraints>

        <properties>
          <text value="backend"/>
          <visible value="false"/>
        </properties>

      </component>


      <!-- ===================================================== -->
      <!-- SPACER -->
      <!-- ===================================================== -->

      <vspacer id="spacer">

        <constraints>
          <grid row="8"
                column="0"
                row-span="2"
                col-span="4"
                vsize-policy="6"
                hsize-policy="1"
                anchor="0"
                fill="2"
                indent="0"
                use-parent-layout="false"/>
        </constraints>

      </vspacer>

    </children>

  </grid>

</form>